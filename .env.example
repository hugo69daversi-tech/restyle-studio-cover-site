# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Cle service_role : jamais exposee au navigateur, utilisee uniquement dans les server actions/routes
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Envoi d'email (SMTP Gmail)
# ReStyleStudioCover@gmail.com > Compte Google > Securite > Validation en 2 etapes > Mots de passe des applications
GMAIL_USER=ReStyleStudioCover@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Destinataires des demandes de contact (separes par des virgules)
CONTACT_RECIPIENTS=ReStyleStudioCover@gmail.com

# URL publique du site (SEO, sitemap, metadonnees)
NEXT_PUBLIC_SITE_URL=https://www.restylestudiocover.fr
